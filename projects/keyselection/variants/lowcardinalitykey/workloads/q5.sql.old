/* Q5 — Join fact to dimension by key (count-only) */
/* KEY TYPE: LowCardinality(String) */
/* SCHEMA: timeseriesdata(name LowCardinality(String), timestamp DateTime64(3)) */

SELECT
  d.group_id,
  count() AS cnt
FROM timeseriesdata AS f
INNER JOIN dim_name AS d
  ON f.name = d.name
WHERE f.timestamp >= toDateTime('2025-12-14')
  AND f.timestamp <  toDateTime('2025-12-18')
GROUP BY d.group_id